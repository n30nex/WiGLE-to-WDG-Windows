# Copy this file to .env, then fill in your credentials.
# Keep .env private. Do not upload or commit it.

# WiGLE option A: paste the single Base64 Basic-auth value WiGLE gives you.
WIGLE_BASIC_TOKEN=

# WiGLE option B: instead of WIGLE_BASIC_TOKEN, fill in both values below.
# WIGLE_API_NAME=
# WIGLE_API_TOKEN=

# WDG / WDG Wars API key.
WDG_API_KEY=
